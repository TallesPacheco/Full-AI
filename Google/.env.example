# ============================================================
# Desafio 1 - RAG com pgVector (mantido)
# ============================================================
OPENAI_API_KEY=
GOOGLE_API_KEY=

OPENAI_MODEL=text-embedding-3-small

PGVECTOR_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PGVECTOR_COLLECTION=gpt5_collection

# ============================================================
# Desafio 2 - Pull/Push/Avaliacao de Prompts (LangSmith Hub)
# ============================================================

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prompt-optimization-challenge

# Username do LangSmith Prompt Hub (sem barra). Necessario para push e evaluate.
# Para descobrir: publique qualquer prompt e abra-o no Hub - o username aparece antes do "/".
USERNAME_LANGSMITH_HUB=

# Provider de LLM: "openai" ou "google"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EVAL_MODEL=gpt-4o
